Begin Object Class=/Script/UnrealEd.EdGraphNode_Comment Name="C4"
   NodeWidth=4550
   NodeHeight=1150
   NodeComment="JA VISTO: conta as piscadas da lanterna\nCada vez que a lanterna RELIGA soma 1 piscada e cancela o apagao (bBlackout=false).\nCom PiscadasNecessarias: para o som, libera o player e o soldado some. Senao continua encarando."
   CommentColor=(R=0.150000,G=0.150000,B=0.150000,A=0.500000)
   NodePosX=2850
   NodePosY=1060
   NodeGuid=34E53B8F0D499EF050BB6CA788B58EE6
End Object
Begin Object Class=/Script/UnrealEd.EdGraphNode_Comment Name="C5"
   NodeWidth=3550
   NodeHeight=1300
   NodeComment="AINDA NAO VISTO: o jogador esta vendo o soldado?\n(nada na frente + dentro do angulo + longe o bastante + renderizado + lanterna ligada e equipada)\nOlhando sem lanterna = encara. Sem olhar = restaura o zoom."
   CommentColor=(R=0.150000,G=0.150000,B=0.150000,A=0.500000)
   NodePosX=2750
   NodePosY=2280
   NodeGuid=B8A838A077ECFEEA8E5542F832369E32
End Object
